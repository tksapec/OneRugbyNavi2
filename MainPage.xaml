<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OneRugbyNavi2"
    x:Class="OneRugbyNavi2.MainPage"
    Title="One Rugby Navi2"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource AppText}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource AppNavy}" />
            <Setter Property="TitleColor" Value="{StaticResource AppMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>

        <Style x:Key="TopActionButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="42" />
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource AppNavy}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="MinimumHeightRequest" Value="46" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="14,10"
          RowSpacing="10">

        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                    <Label Text="One Rugby Navi2"
                           FontSize="22"
                           FontAttributes="Bold"
                           LineBreakMode="NoWrap"
                           TextColor="{StaticResource AppNavy}" />
                    <Label x:Name="seasonTitleLabel"
                           Text=""
                           FontSize="12"
                           TextColor="{StaticResource AppMuted}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                    Text="更新"
                    Style="{StaticResource TopActionButton}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    Clicked="OnRefreshClicked" />
                <Button Grid.Column="2"
                    Text="メニュー"
                    Style="{StaticResource TopActionButton}"
                    BackgroundColor="{StaticResource AppChipBackground}"
                    TextColor="{StaticResource Primary}"
                    Clicked="OnInfoClicked" />
            </Grid>

            <Border Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="10,4">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Picker x:Name="seasonPicker"
                        Title="シーズン"
                        TextColor="{StaticResource AppNavy}"
                        TitleColor="{StaticResource AppMuted}"
                        BackgroundColor="Transparent"
                        SelectedIndexChanged="OnSeasonChanged" />
            </Border>

            <HorizontalStackLayout x:Name="loadingPanel"
                                   Spacing="8"
                                   VerticalOptions="Center"
                                   IsVisible="False">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
                <Label Text="読み込み中..."
                       VerticalTextAlignment="Center"
                       TextColor="{StaticResource AppMuted}" />
            </HorizontalStackLayout>

            <Border x:Name="messagePanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppInformationStroke}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource AppInformationBackground}"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="messageLabel"
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppNavy}" />
            </Border>

            <Border x:Name="cachePanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppWarningStroke}"
                    StrokeThickness="1"
                    BackgroundColor="{StaticResource AppWarningBackground}"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label x:Name="cacheLabel"
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppWarningText}" />
            </Border>
        </VerticalStackLayout>

        <Grid x:Name="divisionTabsGrid"
              Grid.Row="1"
              ColumnDefinitions="*,*,*,*,*"
              Padding="4"
              BackgroundColor="{StaticResource AppChipBackground}"
              ColumnSpacing="4">
            <Button x:Name="btnDiv1"
                    Text="D1"
                    Style="{StaticResource SegmentButton}"
                    Clicked="OnDiv1Clicked" />
            <Button x:Name="btnDiv2"
                    Text="D2"
                    Grid.Column="1"
                    Style="{StaticResource SegmentButton}"
                    Clicked="OnDiv2Clicked" />
            <Button x:Name="btnDiv3"
                    Text="D3"
                    Grid.Column="2"
                    Style="{StaticResource SegmentButton}"
                    Clicked="OnDiv3Clicked" />
            <Button x:Name="btnReplacement"
                    Text="入替戦"
                    Grid.Column="3"
                    Style="{StaticResource SegmentButton}"
                    Clicked="OnReplacementClicked" />
            <Button x:Name="btnOther"
                    Text="その他"
                    Grid.Column="4"
                    Style="{StaticResource SegmentButton}"
                    IsVisible="False"
                    Clicked="OnOtherClicked" />
        </Grid>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Border Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      RowSpacing="8"
                      ColumnSpacing="10">
                    <Button x:Name="filterToggleButton"
                            Text="フィルタを開く"
                            BackgroundColor="{StaticResource AppChipBackground}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            Padding="14,8"
                            Clicked="OnToggleFiltersClicked" />

                    <Label x:Name="lastUpdatedLabel"
                           Grid.Column="1"
                           HorizontalTextAlignment="End"
                           VerticalTextAlignment="Center"
                           FontSize="12"
                           TextColor="{StaticResource AppMuted}"
                           Text="最終更新: -" />

                    <Grid Grid.Row="1"
                          Grid.ColumnSpan="2"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label x:Name="filterSummaryLabel"
                               FontSize="13"
                               TextColor="{StaticResource AppNavy}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               VerticalTextAlignment="Center"
                               Text="フィルタなし" />
                        <Button x:Name="favoriteQuickFilterButton"
                                Grid.Column="1"
                                Text="★ 0"
                                FontSize="12"
                                FontAttributes="Bold"
                                BackgroundColor="{StaticResource AppWarningBackground}"
                                TextColor="{StaticResource AppWarningText}"
                                CornerRadius="12"
                                Padding="10,4"
                                HeightRequest="32"
                                Clicked="OnQuickFavoriteFilterClicked" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="filterDetailsPanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Border Stroke="{StaticResource AppStroke}"
                                BackgroundColor="White"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Picker x:Name="teamPicker"
                                    Title="チーム"
                                    TextColor="{StaticResource AppNavy}"
                                    TitleColor="{StaticResource AppMuted}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="OnTeamFilterChanged" />
                        </Border>

                        <Border Grid.Column="1"
                                Stroke="{StaticResource AppStroke}"
                                BackgroundColor="White"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Picker x:Name="venuePicker"
                                    Title="会場"
                                    TextColor="{StaticResource AppNavy}"
                                    TitleColor="{StaticResource AppMuted}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="OnVenueFilterChanged" />
                        </Border>
                    </Grid>

                    <Border Stroke="{StaticResource AppStroke}"
                            BackgroundColor="White"
                            Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Picker x:Name="periodPicker"
                                Title="期間"
                                TextColor="{StaticResource AppNavy}"
                                TitleColor="{StaticResource AppMuted}"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnPeriodFilterChanged" />
                    </Border>

                    <Border Stroke="{StaticResource AppStroke}"
                            BackgroundColor="{StaticResource AppBackground}"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="お気に入りチーム"
                                       FontSize="12"
                                       TextColor="{StaticResource AppMuted}" />
                                <Label x:Name="favoriteTeamLabel"
                                       Text="お気に入り: 未登録"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AppNavy}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button x:Name="favoriteButton"
                                    Grid.Column="1"
                                    Text="お気に入り登録"
                                    BackgroundColor="{StaticResource AppChipBackground}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    CornerRadius="14"
                                    Padding="12,8"
                                    Clicked="OnFavoriteClicked" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Text="クリア"
                                BackgroundColor="{StaticResource AppChipBackground}"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                Padding="12,10"
                                Clicked="OnClearFilters" />
                        <Button Grid.Column="1"
                                Text="フィルタを閉じる"
                                BackgroundColor="{StaticResource AppSubtleBackground}"
                                TextColor="{StaticResource AppNavy}"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                Padding="12,10"
                                Clicked="OnToggleFiltersClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="3">
            <CollectionView x:Name="list"
                            VerticalOptions="FillAndExpand"
                            SelectionMode="Single"
                            SelectionChanged="OnMatchSelectionChanged"
                            ItemSizingStrategy="MeasureFirstItem">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:MatchItem">
                        <Border Margin="0,0,0,12"
                                Padding="14"
                                Stroke="{StaticResource AppStroke}"
                                StrokeThickness="1"
                                BackgroundColor="White">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="*,Auto"
                                  RowSpacing="10">
                                <HorizontalStackLayout Grid.Row="0" Grid.ColumnSpan="2" Spacing="8">
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="9,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Section}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="White" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource AppSuccessBackground}"
                                            Padding="9,4"
                                            IsVisible="{Binding IsCompleted}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="試合終了"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource AppSuccessText}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource AppNoticeBackground}"
                                            Padding="9,4"
                                            IsVisible="{Binding HasSpecialStatus}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusBadgeText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource AppNoticeText}" />
                                    </Border>
                                    <Label Text="{Binding Conference}"
                                           FontSize="12"
                                           TextColor="{StaticResource AppMuted}"
                                           VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                    <Grid ColumnDefinitions="Auto,*"
                                          ColumnSpacing="8">
                                        <Grid WidthRequest="36" HeightRequest="36">
                                            <ImageButton Source="{Binding HomeLogoPath}"
                                                         BackgroundColor="{StaticResource AppBackground}"
                                                         BorderColor="{StaticResource AppStroke}"
                                                         BorderWidth="1"
                                                         CornerRadius="18"
                                                         Padding="6"
                                                         Aspect="AspectFit"
                                                         Clicked="OnHomeTeamLogoClicked"
                                                         SemanticProperties.Hint="チームの公式ページを開く" />
                                            <Label Text="{Binding HomeBadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   IsVisible="{Binding HasHomeBadge}"
                                                   InputTransparent="True" />
                                        </Grid>
                                        <Label Grid.Column="1"
                                               Text="{Binding HomeTeam}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Start"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    </Grid>
                                    <Label Grid.Column="1"
                                           Text="{Binding ScoreText}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center" />
                                    <Grid Grid.Column="2"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <Label Text="{Binding AwayTeam}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                        <Grid Grid.Column="1" WidthRequest="36" HeightRequest="36">
                                            <ImageButton Source="{Binding AwayLogoPath}"
                                                         BackgroundColor="{StaticResource AppBackground}"
                                                         BorderColor="{StaticResource AppStroke}"
                                                         BorderWidth="1"
                                                         CornerRadius="18"
                                                         Padding="6"
                                                         Aspect="AspectFit"
                                                         Clicked="OnAwayTeamLogoClicked"
                                                         SemanticProperties.Hint="チームの公式ページを開く" />
                                            <Label Text="{Binding AwayBadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   IsVisible="{Binding HasAwayBadge}"
                                                   InputTransparent="True" />
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <VerticalStackLayout Grid.Row="2" Spacing="2">
                                    <Label Text="{Binding DateTimeCompact}"
                                           FontSize="13"
                                           TextColor="{StaticResource AppNavy}" />
                                    <Label Text="{Binding VenueCompact}"
                                           FontSize="12"
                                           TextColor="{StaticResource AppMuted}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>

                                <Label Grid.Row="1"
                                       Grid.Column="1"
                                       Grid.RowSpan="2"
                                       Text=">"
                                       FontSize="34"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="Center"
                                       HorizontalTextAlignment="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border x:Name="emptyStatePanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="18"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Label x:Name="emptyStateLabel"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppMuted}"
                       Text="該当する試合はありません" />
            </Border>
        </Grid>

        <Grid x:Name="menuOverlay"
              Grid.RowSpan="4"
              Margin="-14,-10"
              IsVisible="False"
              ZIndex="10">
            <BoxView BackgroundColor="#660B1729">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMenuBackdropTapped" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border VerticalOptions="End"
                    HorizontalOptions="Fill"
                    Margin="6,0,6,8"
                    Padding="16,15,16,18"
                    BackgroundColor="{StaticResource AppSurface}"
                    Stroke="{StaticResource AppStroke}"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="0">
                    <Label Text="メニュー"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource AppNavy}"
                           Margin="0,0,0,8" />
                    <Button Text="更新状況"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuStatusClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="日程・結果"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuScheduleClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="順位表"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuStandingsClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="チーム一覧"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuTeamsClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="ランキング"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuRankingClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="アプリ情報"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuAboutClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="キャッシュ削除"
                            Style="{StaticResource MenuItemButton}"
                            Clicked="OnMenuClearCacheClicked" />
                    <BoxView HeightRequest="1" Color="{StaticResource AppStroke}" />
                    <Button Text="閉じる"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            MinimumHeightRequest="42"
                            Margin="0,4,0,0"
                            Clicked="OnMenuCloseClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
