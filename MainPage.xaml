<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OneRugbyNavi2"
    x:Class="OneRugbyNavi2.MainPage"
    Title="One Rugby Navi2"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource AppBackground}">

    <ContentPage.Resources>

        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{StaticResource AppText}" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
        </Style>

        <Style TargetType="Picker">
            <Setter Property="TextColor" Value="{StaticResource AppNavy}" />
            <Setter Property="TitleColor" Value="{StaticResource AppMuted}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>

        <Style x:Key="TopActionButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,8" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <Style x:Key="SegmentButton" TargetType="Button">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="MinimumHeightRequest" Value="42" />
        </Style>

        <Style x:Key="MenuItemButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource AppNavy}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="MinimumHeightRequest" Value="46" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          Padding="14,10"
          RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
            <Label x:Name="seasonTitleLabel" Text="日程・結果" FontSize="18"
                   FontAttributes="Bold" VerticalTextAlignment="Center"
                   TextColor="{StaticResource AppNavy}" />
            <Border Grid.Column="1" Stroke="{StaticResource AppStroke}" BackgroundColor="White" Padding="6,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Picker x:Name="seasonPicker" Title="シーズン" MinimumHeightRequest="48"
                        FontSize="14" TextColor="{StaticResource AppNavy}"
                        TitleColor="{StaticResource AppMuted}" BackgroundColor="Transparent"
                        SelectedIndexChanged="OnSeasonChanged" />
            </Border>
            <Button Grid.Column="2" Text="更新" Style="{StaticResource TopActionButton}"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" Clicked="OnRefreshClicked" />
        </Grid>


        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="6" Padding="4"
              BackgroundColor="{StaticResource AppChipBackground}">
            <Button x:Name="scopeAllButton" Text="すべて" Clicked="OnAllMatchesClicked" Style="{StaticResource SegmentButton}" />
            <Button x:Name="scopeFavoritesButton" Grid.Column="1" Text="お気に入り" Clicked="OnFavoriteQuickFilterClicked" Style="{StaticResource SegmentButton}" />
        </Grid>

        <Grid x:Name="divisionTabsGrid" Grid.Row="2" ColumnDefinitions="*,*,*,*,*" Padding="4"
              BackgroundColor="{StaticResource AppChipBackground}" ColumnSpacing="4">
            <Button x:Name="btnDiv1" Text="D1" Style="{StaticResource SegmentButton}" Clicked="OnDiv1Clicked" />
            <Button x:Name="btnDiv2" Text="D2" Grid.Column="1" Style="{StaticResource SegmentButton}" Clicked="OnDiv2Clicked" />
            <Button x:Name="btnDiv3" Text="D3" Grid.Column="2" Style="{StaticResource SegmentButton}" Clicked="OnDiv3Clicked" />
            <Button x:Name="btnReplacement" Text="入替戦" Grid.Column="3" Style="{StaticResource SegmentButton}" Clicked="OnReplacementClicked" />
            <Button x:Name="btnOther" Text="その他" Grid.Column="4" Style="{StaticResource SegmentButton}" IsVisible="False" Clicked="OnOtherClicked" />
            <Grid.GestureRecognizers><SwipeGestureRecognizer Direction="Left" Swiped="OnDivisionTabsSwiped" /><SwipeGestureRecognizer Direction="Right" Swiped="OnDivisionTabsSwiped" /></Grid.GestureRecognizers>
        </Grid>

        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <HorizontalStackLayout x:Name="loadingPanel" Spacing="8" VerticalOptions="Center" IsVisible="False">
                <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" />
                <Label Text="読み込み中..." VerticalTextAlignment="Center" TextColor="{StaticResource AppMuted}" />
            </HorizontalStackLayout>
            <Border x:Name="messagePanel" IsVisible="False" Stroke="{StaticResource AppInformationStroke}"
                    StrokeThickness="1" BackgroundColor="{StaticResource AppInformationBackground}" Padding="12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" HeightRequest="34">
                    <Label x:Name="messageLabel" LineBreakMode="TailTruncation" MaxLines="1"
                           VerticalTextAlignment="Center" FontSize="12" TextColor="{StaticResource AppNavy}" />
                    <Button Grid.Column="1" Text="詳細" FontSize="12" Padding="8,2" MinimumHeightRequest="32"
                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                            Clicked="OnShowStatusClicked" SemanticProperties.Hint="更新状況の詳細を表示します" />
                </Grid>
            </Border>
            <Border x:Name="cachePanel" IsVisible="False" Stroke="{StaticResource AppWarningStroke}"
                    StrokeThickness="1" BackgroundColor="{StaticResource AppWarningBackground}" Padding="12">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Label x:Name="cacheLabel" LineBreakMode="WordWrap" TextColor="{StaticResource AppWarningText}" />
            </Border>
            <Border Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="10,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                      RowSpacing="4" ColumnSpacing="6">
                    <Button x:Name="filterToggleButton"
                            Text="絞り込み"
                            ImageSource="schedule_filter.svg"
                            ContentLayout="Left,6"
                            BackgroundColor="{StaticResource AppChipBackground}"
                            TextColor="{StaticResource Primary}"
                            FontAttributes="Bold"
                            CornerRadius="14"
                            MinimumHeightRequest="48"
                            Padding="10,6"
                            Clicked="OnToggleFiltersClicked" />

                    <Border x:Name="filterCountBadge" Grid.Column="1" IsVisible="False"
                            WidthRequest="24" HeightRequest="24" Padding="0"
                            BackgroundColor="{StaticResource Primary}" StrokeThickness="0"
                            VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Label x:Name="filterCountLabel" FontSize="12" FontAttributes="Bold"
                               TextColor="White" HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </Border>

                    <Button x:Name="clearQuickButton" Grid.Column="2" Text="解除"
                            IsVisible="False" MinimumHeightRequest="44" Padding="4,6"
                            BackgroundColor="Transparent" TextColor="{StaticResource Primary}"
                            FontAttributes="Bold" Clicked="OnClearFilters" />

                    <BoxView Grid.Column="3" WidthRequest="1" HeightRequest="26"
                             HorizontalOptions="End" VerticalOptions="Center"
                             BackgroundColor="{StaticResource AppStroke}" />

                    <Button x:Name="nextMatchButton" Grid.Column="4" Text="次の試合へ ›"
                            MinimumHeightRequest="48" Padding="10,6" CornerRadius="12"
                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                            FontAttributes="Bold" Clicked="OnNextMatchClicked" />
                    <Label x:Name="filterSummaryLabel"
                               Grid.Row="1" Grid.ColumnSpan="5"
                               FontSize="13"
                               TextColor="{StaticResource AppNavy}"
                               LineBreakMode="TailTruncation"
                               MaxLines="2"
                               VerticalTextAlignment="Center"
                               Text="フィルタなし" />
                </Grid>
            </Border>

            <Border x:Name="filterDetailsPanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">
                    <ScrollView MaximumHeightRequest="360">
                    <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Border Stroke="{StaticResource AppStroke}"
                                BackgroundColor="White"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Picker x:Name="teamPicker"
                                    Title="チーム"
                                    TextColor="{StaticResource AppNavy}"
                                    TitleColor="{StaticResource AppMuted}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="OnTeamFilterChanged" />
                        </Border>

                        <Border Grid.Column="1"
                                Stroke="{StaticResource AppStroke}"
                                BackgroundColor="White"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Picker x:Name="venuePicker"
                                    Title="会場"
                                    TextColor="{StaticResource AppNavy}"
                                    TitleColor="{StaticResource AppMuted}"
                                    BackgroundColor="Transparent"
                                    SelectedIndexChanged="OnVenueFilterChanged" />
                        </Border>
                    </Grid>

                    <Border Stroke="{StaticResource AppStroke}"
                            BackgroundColor="White"
                            Padding="10,6">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Picker x:Name="periodPicker"
                                Title="期間"
                                TextColor="{StaticResource AppNavy}"
                                TitleColor="{StaticResource AppMuted}"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnPeriodFilterChanged" />
                    </Border>

                    <Border Stroke="{StaticResource AppStroke}"
                            BackgroundColor="{StaticResource AppBackground}"
                            Padding="12,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="お気に入りチーム"
                                       FontSize="12"
                                       TextColor="{StaticResource AppMuted}" />
                                <Label x:Name="favoriteTeamLabel"
                                       Text="お気に入り: 未登録"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource AppNavy}"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <Button x:Name="favoriteButton"
                                    Grid.Column="1"
                                    Text="お気に入り登録"
                                    BackgroundColor="{StaticResource AppChipBackground}"
                                    TextColor="{StaticResource Primary}"
                                    FontAttributes="Bold"
                                    CornerRadius="14"
                                    Padding="12,8"
                                    Clicked="OnFavoriteClicked" />
                        </Grid>
                    </Border>
                    </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <Grid Grid.Row="4" IsClippedToBounds="True">
            <Grid x:Name="schedulePageContent">
            <CollectionView x:Name="list" IsGrouped="True" VerticalOptions="FillAndExpand"
                            SelectionMode="None" ItemSizingStrategy="MeasureAllItems">
                <CollectionView.GroupHeaderTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource AppChipBackground}" Stroke="{StaticResource AppStroke}" Padding="12,7" Margin="0,0,0,6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Label Text="{Binding DateLabel}" FontSize="15" FontAttributes="Bold"
                                   TextColor="{StaticResource AppNavy}" />
                        </Border>
                    </DataTemplate>
                </CollectionView.GroupHeaderTemplate>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:MatchItem">
                            <Border Margin="0,0,0,12"
                                Padding="14"
                                Stroke="{StaticResource AppStroke}"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                SemanticProperties.Hint="試合詳細を表示します。チームロゴをタップすると公式ページを開きます。">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMatchTapped" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6">
                                <FlexLayout Wrap="Wrap" AlignItems="Center" Padding="0,10,0,4">
                                    <Border BackgroundColor="{StaticResource Primary}" Padding="8,4" Margin="0,0,6,4">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Label Text="{Binding CategoryLabel}" FontSize="12" FontAttributes="Bold" TextColor="White" />
                                </Border>
                                <Label Text="{Binding RoundTimeCompact}" FontSize="13" FontAttributes="Bold" Margin="0,0,8,4" TextColor="{StaticResource AppNavy}" />
                                    <Border BackgroundColor="{StaticResource AppSuccessBackground}"
                                            Padding="9,6" Margin="0,0,6,4"
                                            IsVisible="{Binding IsCompleted}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="試合終了"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource AppSuccessText}" />
                                    </Border>
                                    <Border BackgroundColor="{StaticResource AppNoticeBackground}"
                                            Padding="9,6" Margin="0,0,6,4"
                                            IsVisible="{Binding HasSpecialStatus}">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="9" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding StatusBadgeText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource AppNoticeText}" />
                                    </Border>
                                    <Label Text="{Binding Conference}"
                                           FontSize="12"
                                           TextColor="{StaticResource AppMuted}"
                                           Margin="0,0,0,4"
                                           VerticalTextAlignment="Center" />
                                </FlexLayout>

                                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
                                        <Grid WidthRequest="48" HeightRequest="48">
                                            <ImageButton Source="{Binding HomeLogoPath}"
                                                         BackgroundColor="{StaticResource AppBackground}"
                                                         BorderColor="{StaticResource AppStroke}"
                                                         BorderWidth="1"
                                                         CornerRadius="24"
                                                         Padding="8"
                                                         Aspect="AspectFit"
                                                         Clicked="OnHomeTeamLogoClicked"
                                                         SemanticProperties.Hint="チームの公式ページを開く" />
                                            <Label Text="{Binding HomeBadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   IsVisible="{Binding HasHomeBadge}"
                                                   InputTransparent="True" />
                                        </Grid>
                                        <Label Grid.Column="1"
                                               Text="{Binding HomeTeam}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Start"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                    <Label Grid.Column="2"
                                           Text="{Binding HomeScoreText}"
                                           SemanticProperties.Description="{Binding HomeScoreText, StringFormat='ホームの得点 {0}'}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           MinimumWidthRequest="32"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="10">
                                        <Label Grid.Column="1" Text="{Binding AwayTeam}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Start"
                                               VerticalTextAlignment="Center"
                                               LineBreakMode="WordWrap" />
                                        <Grid WidthRequest="48" HeightRequest="48">
                                            <ImageButton Source="{Binding AwayLogoPath}"
                                                         BackgroundColor="{StaticResource AppBackground}"
                                                         BorderColor="{StaticResource AppStroke}"
                                                         BorderWidth="1"
                                                         CornerRadius="24"
                                                         Padding="8"
                                                         Aspect="AspectFit"
                                                         Clicked="OnAwayTeamLogoClicked"
                                                         SemanticProperties.Hint="チームの公式ページを開く" />
                                            <Label Text="{Binding AwayBadgeText}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalTextAlignment="Center"
                                                   IsVisible="{Binding HasAwayBadge}"
                                                   InputTransparent="True" />
                                        </Grid>
                                    <Label Grid.Column="2"
                                           Text="{Binding AwayScoreText}"
                                           SemanticProperties.Description="{Binding AwayScoreText, StringFormat='ビジターの得点 {0}'}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}"
                                           MinimumWidthRequest="32"
                                           HorizontalTextAlignment="End"
                                           VerticalTextAlignment="Center" />
                                </Grid>

                                <Button Text="{Binding ResultVisibilityActionText}" IsVisible="{Binding HasResult}"
                                        SemanticProperties.Description="{Binding ScoreVisibilityDescription}"
                                        HorizontalOptions="End" MinimumHeightRequest="40" Padding="12,4"
                                        CornerRadius="12" BackgroundColor="{StaticResource AppChipBackground}"
                                        TextColor="{StaticResource Primary}" Clicked="OnResultVisibilityClicked" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding VenueCompact}"
                                           FontSize="12"
                                           TextColor="{StaticResource AppMuted}"
                                           LineBreakMode="WordWrap" />
                                <Label Grid.Column="1"
                                       Text="詳細を見る ›"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       VerticalTextAlignment="End"
                                       HorizontalTextAlignment="End" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border x:Name="emptyStatePanel"
                    IsVisible="False"
                    Stroke="{StaticResource AppStroke}"
                    BackgroundColor="White"
                    Padding="18"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="18" />
                </Border.StrokeShape>
                <Label x:Name="emptyStateLabel"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{StaticResource AppMuted}"
                       Text="該当する試合はありません" />
            </Border>
            </Grid>
        </Grid>

        <ContentView x:Name="bottomNavigationHost" Grid.Row="5" />

        <GraphicsView x:Name="pageCurlOverlay" Grid.RowSpan="6"
                          IsVisible="False"
                          InputTransparent="True"
                          ZIndex="10" />
    </Grid>
</ContentPage>
