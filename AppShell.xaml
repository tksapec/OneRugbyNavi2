<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="OneRugbyNavi2.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:OneRugbyNavi2"
    Title="One Rugby Navi2"
    Shell.BackgroundColor="{StaticResource AppSurface}"
    Shell.ForegroundColor="{StaticResource AppNavy}"
    Shell.TitleColor="{StaticResource AppNavy}"
    Shell.TabBarBackgroundColor="{StaticResource AppSurface}"
    Shell.TabBarForegroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="{StaticResource Primary}"
    Shell.TabBarUnselectedColor="{StaticResource AppMuted}">

    <TabBar>
        <ShellContent
            Title="日程"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="SchedulePage" />

        <ShellContent
            Title="チーム"
            ContentTemplate="{DataTemplate local:TeamListPage}"
            Route="TeamListPage" />

        <ShellContent
            Title="ランキング"
            ContentTemplate="{DataTemplate local:RankingPage}"
            Route="RankingPage" />

        <ShellContent
            Title="情報"
            ContentTemplate="{DataTemplate local:InfoPage}"
            Route="InfoPage" />
    </TabBar>

</Shell>
